# Credenciales de SauceDemo (opcionales).
# Copia este archivo a .env y ajusta los valores si lo necesitas.
# Si no se definen, los tests usan los usuarios publicos de la demo.

# Usuario estandar
SAUCE_USER=standard_user
SAUCE_PASSWORD=secret_sauce

# Usuario bloqueado (test de login rechazado)
SAUCE_LOCKED_USER=locked_out_user
SAUCE_LOCKED_PASSWORD=secret_sauce

# Usuario con defectos conocidos (tests de bugs SCRUM-7)
SAUCE_PROBLEM_USER=problem_user
SAUCE_PROBLEM_PASSWORD=secret_sauce

# API de practica Restful-Booker (credenciales de demo publicas)
BOOKING_API_URL=https://restful-booker.herokuapp.com
BOOKING_API_USER=admin
BOOKING_API_PASSWORD=password123
